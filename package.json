{
  "x-fork-modification-notice": "Modified in the alexandarM/SionnaRTStudio fork of puloktarafder/SionnaRTStudio.",
"name": "sionna-rt-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bash run.sh",
    "setup": "bash setup.sh",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:osm-parser": "node --import tsx scripts/check-osm-parser.ts",
    "freeze:osm-scene": "node --import tsx scripts/freeze-osm-scene.ts",
    "check:preview-lod": "node --import tsx scripts/check-preview-lod.mjs",
    "check:base-station-import": "node --import tsx scripts/check-base-station-import.ts",
    "check:georeference": "node --import tsx scripts/check-georeference.ts",
    "check:link-matrix-persistence": "node --import tsx scripts/check-link-matrix-persistence.ts",
    "check:measurement-overlay": "node --import tsx scripts/check-measurement-overlay.ts",
    "check:panel-lifecycle": "node scripts/check-panel-lifecycle.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.184.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
